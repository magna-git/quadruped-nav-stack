Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan_synced
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /dog_odom
    - Class: rviz_default_plugins/MarkerArray
      Name: ParticleCloud
      Enabled: true
      Topic:
        Value: /particle_cloud
    - Class: nav2_rviz_plugins/GoalTool
      Name: Nav2 Goal
      Enabled: true
    - Class: nav2_rviz_plugins/InitialPoseTool
      Name: 2D Pose Estimate
      Enabled: true
  Global Options:
    Fixed Frame: map
  Name: root
