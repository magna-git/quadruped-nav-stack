<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_slam</name>
  <version>0.1.0</version>
  <description>Stable 2D mapping and scan diagnostics for the B2-W SLAM Toolbox stack.</description>
  <maintainer email="dia.khadijetou96@gmail.com">unitree</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_map_server</depend>
  <depend>slam_toolbox</depend>
  <depend>quadruped_bringup</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
